<Window x:Class="DeepSeekMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="380" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="BgColor" Color="#1a1b26"/>
        <SolidColorBrush x:Key="CardColor" Color="#24253b"/>
        <SolidColorBrush x:Key="AccentColor" Color="#7aa2f7"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#c0caf5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#787c99"/>
        <Style x:Key="TBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="24"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="4,2"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2f3145"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgColor}" CornerRadius="12" BorderBrush="#2f3145" BorderThickness="1" MouseLeftButtonDown="Window_MouseDown">
        <Grid Margin="16,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="设置" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <Button Content="&#x2715;" Style="{StaticResource TBtn}" HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>
            <StackPanel Grid.Row="1">
                <TextBlock Text="第一步：配置 API Key" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid><TextBox x:Name="ApiKeyBox" Background="#24253b" Foreground="#c0caf5" BorderBrush="#2f3145" BorderThickness="1" FontSize="13" Padding="8,6" TextChanged="ApiKeyBox_TextChanged"/>
                        <TextBlock x:Name="ApiPlaceholder" Text="请输入 API Key" Foreground="#4a4d6a" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <Button x:Name="VerifyButton" Grid.Column="2" Content="验证" Width="60" Background="{StaticResource AccentColor}" Foreground="#1a1b26" BorderThickness="0" FontSize="12" FontWeight="Bold" Click="Verify_Click"/>
                    <Button x:Name="EyeButton" Grid.Column="4" Content="&#x1F441;" Width="36" Background="#3b4261" Foreground="#c0caf5" BorderThickness="0" FontSize="14" Cursor="Hand" Click="Eye_Click" ToolTip="显示/隐藏"/>
                </Grid>
                <TextBlock x:Name="ApiStatusLabel" FontSize="12" Foreground="#449d87" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="清除" Width="60" Background="#3b4261" Foreground="#c0caf5" BorderThickness="0" FontSize="12" Click="Clear_Click" Margin="0,0,8,0"/>
                    <Button Content="保存" Width="60" Background="{StaticResource AccentColor}" Foreground="#1a1b26" BorderThickness="0" FontSize="12" FontWeight="Bold" Click="Save_Click"/>
                </StackPanel>
                <Rectangle Height="1" Fill="#2f3145" Margin="0,0,0,16"/>

                <TextBlock Text="第二步：自动导入用量数据" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                <Button x:Name="AutoExportBtn" Content="打开自动导出" Width="140" Background="{StaticResource AccentColor}" Foreground="#1a1b26" BorderThickness="0" FontSize="12" FontWeight="Bold" Click="AutoExport_Click" Margin="0,0,0,8"/>
                <CheckBox x:Name="AutoImportCheck" Content="每次打开时自动导入" Foreground="#c0caf5" FontSize="12" Margin="0,0,0,6" Checked="AutoImportCheck_Changed" Unchecked="AutoImportCheck_Changed"/>
                <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Foreground="#c0caf5" FontSize="12" Margin="0,0,0,6" Checked="AutoStartCheck_Changed" Unchecked="AutoStartCheck_Changed"/>
                <TextBlock Text="主界面右下角「少峰」点击可切换置顶" FontSize="11" Foreground="#787c99" Margin="0,0,0,16"/>
                <Rectangle Height="1" Fill="#2f3145" Margin="0,0,0,16"/>

                <TextBlock Text="字体设置" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                    <TextBlock Text="数字大小" VerticalAlignment="Center" FontSize="12" Foreground="#c0caf5"/>
                    <Slider x:Name="NumberFontSlider" Grid.Column="1" Minimum="12" Maximum="48" Value="{Binding NumberFontSize}" TickFrequency="2" IsSnapToTickEnabled="True"/>
                    <TextBlock Grid.Column="2" Text="{Binding NumberFontSize, StringFormat={}{0:F0}}" VerticalAlignment="Center" FontSize="12" Foreground="#c0caf5" Margin="8,0,0,0"/>
                </Grid>
                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                    <TextBlock Text="标签大小" VerticalAlignment="Center" FontSize="12" Foreground="#c0caf5"/>
                    <Slider x:Name="LabelFontSlider" Grid.Column="1" Minimum="10" Maximum="24" Value="{Binding LabelFontSize}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Grid.Column="2" Text="{Binding LabelFontSize, StringFormat={}{0:F0}}" VerticalAlignment="Center" FontSize="12" Foreground="#c0caf5" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Text="作者：少峰" FontSize="11" Foreground="#7aa2f7" HorizontalAlignment="Right" Margin="0,0,0,8"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
