<Window x:Class="DeepSeekMonitor.AutoExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DeepSeek 自动导出" Width="960" Height="720" Background="#1a1b26" Foreground="#c0caf5"
        FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <wv2:WebView2 x:Name="Browser" Grid.Row="0"/>
        <Border Grid.Row="1" Background="#24253b" Padding="14,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="StatusText" Text="正在加载..." FontSize="12" Foreground="#787c99"/>
                    <TextBlock x:Name="DetailText" FontSize="11" Foreground="#449d87" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="重试" Width="80" Background="#3b4261" Foreground="#c0caf5" BorderThickness="0" FontSize="12" Click="Retry_Click" Margin="0,0,8,0"/>
                    <Button Content="关闭" Width="60" Background="#7aa2f7" Foreground="#1a1b26" BorderThickness="0" FontSize="12" FontWeight="Bold" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
